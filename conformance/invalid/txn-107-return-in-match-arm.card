// rule: TXN-6
// source: DN §3.6
// status: agreed
// kind: fragment
// expect: compile-error CE-TXN-1
// note: return in a match arm inside a transaction.
persistent balance: u32;

function helper() {
    balance = 0;
    return Ok();
}

function check() {
    transaction {
        match helper() {
            Ok() => {
            }
            Err(error) => {
                return Err(error);
            }
        }
    }
    return Ok();
}
