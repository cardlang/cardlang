// rule: PLT-25, FUN-7
// source: platform/base-profile.md BP-26 to BP-33
// status: agreed
// kind: fragment
// expect: compile-error CE-FUN-2
// note: The output of card.crypto.digest is an inout parameter.
function hash(data: ref u8[], out: inout u8[]) -> u32 {
    var length: u32 = attempt card.crypto.digest(DigestAlgorithm.Sha256, ref data, out);
    return Ok(length);
}
