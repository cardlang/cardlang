// rule: FUN-7
// source: DN §3.7
// status: agreed
// kind: fragment
// expect: compile-error CE-FUN-2
// note: A ref parameter given an inout argument.
struct Account {
    balance: u32;
}

session account: Account;

function inspect(source: ref Account) {
    return Ok();
}

function check() {
    attempt inspect(inout account);
    return Ok();
}
