// rule: TXN-6
// source: DN §3.6
// status: agreed
// kind: fragment
// expect: compile-error CE-TXN-1
// note: continue targeting a loop around the transaction.
persistent balance: u32;

function check() {
    for index: u8 in 0..4 {
        transaction {
            balance = 0;
            continue;
        }
    }
    return Ok();
}
