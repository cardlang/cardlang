// rule: TXN-6
// source: DN §3.6
// status: agreed
// kind: fragment
// expect: compile-error CE-TXN-1
// note: break targeting a loop around the transaction.
persistent balance: u32;

function check() {
    while true {
        transaction {
            balance = 0;
            break;
        }
    }
    return Ok();
}
