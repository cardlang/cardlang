// rule: FUN-9
// source: DN §3.8
// status: agreed
// kind: fragment
// expect: compile-error CE-FUN-3
// note: A reference to an arithmetic expression.
function count(value: ref u32) -> u32 {
    return Ok(value);
}

function check(limit: u32) {
    var total: u32 = attempt count(ref (limit + 1));
    return Ok();
}
