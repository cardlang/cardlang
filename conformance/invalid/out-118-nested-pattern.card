// note: A nested pattern Ok(State.Idle).
enum State {
    Idle;
    Busy;
}

function read_state() -> State {
    return Ok(State.Idle);
}

function check() {
    match read_state() {
        Ok(State.Idle) => {
        }
        Ok(_) => {
        }
        Err(_) => {
        }
    }
    return Ok();
}
