// rule: TXN-10
// source: DN §7.3
// status: agreed
// kind: fragment
// expect: compile-error CE-TXN-3
// note: A transaction reached through a call from inside another.
persistent value: u32;

function update() {
    transaction {
        value = 1;
    }
    return Ok();
}

function outer() {
    transaction {
        match update() {
            Ok() => {
            }
            Err(_) => {
            }
        }
    }
    return Ok();
}
