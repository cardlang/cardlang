// rule: OUT-9, OUT-10
// source: DN §6.3
// status: agreed
// kind: fragment
// expect: ok
// note: attempt as an initializer and as a statement.
function read_value() -> u32 {
    return Ok(7);
}

function authenticate() {
    return Ok();
}

function is_nonzero() -> bool {
    attempt authenticate();
    var value: u32 = attempt read_value();
    return Ok(value != 0);
}
