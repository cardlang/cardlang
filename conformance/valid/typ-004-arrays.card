// rule: TYP-17, TYP-18
// source: DN §8, §8.2
// status: agreed
// kind: fragment
// expect: ok
// note: Arrays of integers, Booleans, structures and enums.
struct Account {
    balance: u32;
    identifier: u8[4];
    counters: u32[8];
}

enum Mode {
    Off;
    On;
}

session buffer: u8[128];
session counters: u32[8];
session enabled: bool[8];
session accounts: Account[4];
session modes: Mode[2];
