// rule: OUT-15, OUT-16
// source: DN §6.3
// status: agreed
// kind: fragment
// expect: ok
// note: An error set with literal codes.
errors WalletError {
    InsufficientFunds = 1;
    AccountBlocked = 2;
    InvalidAmount = 3;
    Unauthorized = 4;
}

function refuse() {
    return Err(WalletError.Unauthorized);
}
