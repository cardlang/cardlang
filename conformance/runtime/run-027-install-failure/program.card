// rule: STA-6
// source: platform/base-profile.md BP-55
// status: agreed
// kind: application
// expect: runtime
// note: Profile BP-55: when on_install returns Err, installation fails and the outcome is reported.
errors AppError {
    Refused = 7;
}

persistent marker: u8;

function on_install() {
    marker = 1;
    return Err(AppError.Refused);
}

command process(request: ref u8[], response: inout u8[]) -> u32 {
    response[0] = marker;
    return Ok(1);
}
