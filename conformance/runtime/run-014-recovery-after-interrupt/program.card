// rule: TXN-13, RTF-10
// source: DN §7.2
// status: agreed
// kind: application
// expect: runtime
// requires: fault-injection
// note: Power loss during a commit recovers to all-or-nothing.
persistent first: u32;
persistent second: u32;

command process(request: ref u8[], response: inout u8[]) -> u32 {
    transaction {
        first = first + 1;
        second = second + 1;
    }
    response[0] = truncate<u8>(first);
    response[1] = truncate<u8>(second);
    return Ok(2);
}
