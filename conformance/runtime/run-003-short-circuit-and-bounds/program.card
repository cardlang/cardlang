// rule: EXP-21, EXP-39
// source: DN §3.5, §8.1
// status: agreed
// kind: application
// expect: runtime
// note: Short-circuiting prevents an out-of-range index; an unguarded index traps.
session table: u8[4];

command process(request: ref u8[], response: inout u8[]) -> u32 {
    var index: u8 = request[1];
    if request[0] == 1 {
        var free: bool = (index < 4) and (table[index] == 0);
        if free {
            response[0] = 1;
        } else {
            response[0] = 0;
        }
        return Ok(1);
    }
    response[0] = table[index];
    return Ok(1);
}
