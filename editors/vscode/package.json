{
  "name": "cardlang",
  "displayName": "CardLang",
  "description": "CardLang for VS Code: highlighting, diagnostics as you type, building, running and debugging applets.",
  "version": "0.1.2",
  "publisher": "cardlang",
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#14264D", "theme": "dark" },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/cardlang/cardlang", "directory": "editors/vscode" },
  "homepage": "https://github.com/cardlang/cardlang#readme",
  "bugs": { "url": "https://github.com/cardlang/cardlang/issues" },
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/cardlang.json",
    "onDebugResolve:cardlang",
    "onDebugInitialConfigurations",
    "onDebugDynamicConfigurations:cardlang"
  ],
  "scripts": {
    "package": "vsce package --out cardlang.vsix"
  },
  "contributes": {
    "semanticTokenModifiers": [
      {
        "id": "persistent",
        "description": "Lives in persistent storage: a persistent global"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "cardlang",
        "scopes": {
          "variable.persistent": [
            "variable.other.persistent.cardlang"
          ],
          "variable.static": [
            "variable.other.session.cardlang"
          ],
          "macro.defaultLibrary": [
            "support.function.intrinsic.cardlang"
          ],
          "namespace.defaultLibrary": [
            "support.class.platform.cardlang"
          ],
          "function.defaultLibrary": [
            "support.function.platform.cardlang"
          ],
          "type.defaultLibrary": [
            "support.type.primitive.cardlang"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[cardlang]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "languages": [
      {
        "id": "cardlang",
        "aliases": [
          "CardLang",
          "cardlang"
        ],
        "extensions": [
          ".card"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cardlang-scenario",
        "aliases": [
          "CardLang Scenario"
        ],
        "extensions": [
          ".scenario"
        ],
        "filenames": [
          "scenario.txt"
        ],
        "configuration": "./language-configuration-scenario.json"
      }
    ],
    "grammars": [
      {
        "language": "cardlang",
        "scopeName": "source.cardlang",
        "path": "./syntaxes/cardlang.tmLanguage.json"
      },
      {
        "language": "cardlang-scenario",
        "scopeName": "source.cardlang-scenario",
        "path": "./syntaxes/cardlang-scenario.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cardlang",
        "path": "./snippets/cardlang.json"
      }
    ],
    "commands": [
      {
        "command": "cardlang.build",
        "title": "Build Applet",
        "category": "CardLang",
        "icon": "$(package)"
      },
      {
        "command": "cardlang.check",
        "title": "Check Applet",
        "category": "CardLang"
      },
      {
        "command": "cardlang.runScenario",
        "title": "Run Scenario",
        "category": "CardLang",
        "icon": "$(play)"
      },
      {
        "command": "cardlang.debugScenario",
        "title": "Debug Scenario",
        "category": "CardLang",
        "icon": "$(debug-alt)"
      },
      {
        "command": "cardlang.restartServer",
        "title": "Restart Language Server",
        "category": "CardLang"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cardlang.build",
          "when": "editorLangId == cardlang",
          "group": "navigation"
        },
        {
          "command": "cardlang.runScenario",
          "when": "editorLangId == cardlang-scenario",
          "group": "navigation"
        },
        {
          "command": "cardlang.debugScenario",
          "when": "editorLangId == cardlang-scenario",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "cardlang.runScenario",
          "when": "editorLangId == cardlang-scenario"
        },
        {
          "command": "cardlang.debugScenario",
          "when": "editorLangId == cardlang-scenario"
        }
      ]
    },
    "configuration": {
      "title": "CardLang",
      "properties": {
        "cardlang.repository": {
          "type": "string",
          "default": "",
          "description": "The CardLang repository, whose pyproject.toml names the cardlang package. Empty: the workspace folder that contains it, or a folder above it."
        },
        "cardlang.uvPath": {
          "type": "string",
          "default": "uv",
          "description": "The uv executable that runs the CardLang commands (clc, cardlang-lsp, cardlang-dap) in the repository's Python environment."
        },
        "cardlang.scenarioBackend": {
          "type": "string",
          "default": "pyvm",
          "enum": [
            "pyvm",
            "interp",
            "cvm"
          ],
          "enumDescriptions": [
            "The Python VM",
            "The reference interpreter",
            "The C VM (build it first: vm/c/README.md)"
          ],
          "description": "Where Run Scenario runs the applet."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "cardlang",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "check",
              "build",
              "run"
            ]
          },
          "program": {
            "type": "string",
            "description": "A project directory or a .card file"
          },
          "scenario": {
            "type": "string"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "cardlang",
        "owner": "cardlang",
        "source": "cardlang",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (CE-[A-Z]+-\\d+|BP-[0-9a-z]+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    ],
    "breakpoints": [
      {
        "language": "cardlang"
      },
      {
        "language": "cardlang-scenario"
      }
    ],
    "debuggers": [
      {
        "type": "cardlang",
        "label": "CardLang",
        "languages": [
          "cardlang",
          "cardlang-scenario"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "scenario"
            ],
            "properties": {
              "scenario": {
                "type": "string",
                "description": "The scenario file that drives the applet.",
                "default": "${file}"
              },
              "program": {
                "type": "string",
                "description": "The applet: a directory with cardlang.json, or a .card file. Default: the scenario's directory."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the scenario's first step.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "cardlang",
            "request": "launch",
            "name": "Debug scenario",
            "scenario": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "CardLang: Debug a scenario",
            "description": "Run a scenario file against its applet on the Python VM",
            "body": {
              "type": "cardlang",
              "request": "launch",
              "name": "Debug scenario",
              "scenario": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1"
  }
}
