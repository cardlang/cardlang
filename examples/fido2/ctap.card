// The CTAP 2.0 commands (CTAP 2.1 §6): getInfo, makeCredential, getAssertion and reset.
// Each handler writes the CTAP status byte and CBOR response into `response`, and returns its length.
// A CTAP error is returned as an IsoError.Ctap* member; the entry point turns it into a status byte.

// Dispatch one CTAP message: the command byte, then its CBOR parameters.
function ctap(message: ref u8[], response: inout u8[]) -> u32 {
    require message.length >= 1 else IsoError.CtapInvalidLength;
    var code: u8 = message[0];
    if code == 0x04 {
        return get_info(inout response);
    }
    if code == 0x07 {
        return reset_authenticator(inout response);
    }
    require (code == 0x01) or (code == 0x02) or (code == 0x06) else IsoError.CtapInvalidCommand;
    var length: u32 = attempt card.cbor.validate(ref message[1..message.length]) else IsoError.CtapInvalidCbor;
    require length == (message.length - 1) else IsoError.CtapInvalidCbor;
    if code == 0x01 {
        return make_credential(ref message[1..message.length], inout response);
    }
    if code == 0x06 {
        return client_pin(ref message[1..message.length], inout response);
    }
    return get_assertion(ref message[1..message.length], inout response);
}

// authenticatorGetInfo (0x04):
// {1: ["FIDO_2_0"], 3: AAGUID, 4: {"rk": false, "up": true, "plat": false, "clientPin": pin_set}, 5: 1280, 6: [2, 1]}
function get_info(response: inout u8[]) -> u32 {
    response[0] = 0;
    var at: u32 = 1;
    at += attempt card.cbor.write_head(CborMajor.Map, 5, inout response[at..response.length]);
    at += attempt card.cbor.write_int(1, inout response[at..response.length]);
    at += attempt card.cbor.write_head(CborMajor.Array, 1, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref VERSION, inout response[at..response.length]);
    at += attempt card.cbor.write_int(3, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Bytes, ref AAGUID, inout response[at..response.length]);
    at += attempt card.cbor.write_int(4, inout response[at..response.length]);
    at += attempt card.cbor.write_head(CborMajor.Map, 4, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref KEY_RK, inout response[at..response.length]);
    at += attempt card.cbor.write_bool(false, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref KEY_UP, inout response[at..response.length]);
    at += attempt card.cbor.write_bool(true, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref KEY_PLAT, inout response[at..response.length]);
    at += attempt card.cbor.write_bool(false, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref KEY_CLIENT_PIN, inout response[at..response.length]);
    at += attempt card.cbor.write_bool(pin_set, inout response[at..response.length]);
    at += attempt card.cbor.write_int(5, inout response[at..response.length]);
    at += attempt card.cbor.write_int(1280, inout response[at..response.length]);
    at += attempt card.cbor.write_int(6, inout response[at..response.length]);
    at += attempt card.cbor.write_head(CborMajor.Array, 2, inout response[at..response.length]);
    at += attempt card.cbor.write_int(2, inout response[at..response.length]);
    at += attempt card.cbor.write_int(1, inout response[at..response.length]);
    return Ok(at);
}

// authenticatorMakeCredential (0x01), with ES256, "none" attestation and a non-resident credential.
function make_credential(params: ref u8[], response: inout u8[]) -> u32 {
    var p: u32[11];
    var end: u32 = attempt index_map(ref params, 0, inout p);
    require (p[1] != 0) and (p[2] != 0) and (p[3] != 0) and (p[4] != 0) else IsoError.CtapMissingParameter;
    var client_hash: Span = attempt read_string(ref params, p[1], CborMajor.Bytes);
    require client_hash.length == 32 else IsoError.CtapInvalidParameter;
    var id_at: u32 = attempt find_text_key(ref params, p[2], ref KEY_ID);
    require id_at != 0 else IsoError.CtapMissingParameter;
    var rp_id: Span = attempt read_string(ref params, id_at, CborMajor.Text);
    var user: CborHead = attempt card.cbor.head(ref params[p[3]..params.length]);
    require user.major == CborMajor.Map else IsoError.CtapUnexpectedType;
    var es256: bool = attempt supports_es256(ref params, p[4]);
    require es256 else IsoError.CtapUnsupportedAlgorithm;
    var options: Options = attempt read_options(ref params, p[7]);
    require not options.rk else IsoError.CtapUnsupportedOption;
    require not options.uv else IsoError.CtapUnsupportedOption;
    require options.up else IsoError.CtapInvalidOption;
    var uv: bool = attempt check_token_param(ref params, client_hash, p[8], p[9]);
    require uv or (not pin_set) else IsoError.CtapPinRequired;            // CTAP 2.1 §6.1.2
    var rp_hash: u8[32];
    var n: u32 = attempt card.crypto.digest(DigestAlgorithm.Sha256, ref params[rp_id.start..rp_id.start + rp_id.length], inout rp_hash);
    if p[5] != 0 {
        var excluded: u32 = attempt first_valid(ref params, p[5], ref rp_hash);
        require excluded == 0 else IsoError.CtapCredentialExcluded;
    }

    // The credential: a random nonce, its tag, and the derived key's public point.
    var credential_id: u8[48];
    n = attempt card.random.fill(inout credential_id[0..32]);
    attempt credential_tag(ref rp_hash, ref credential_id[0..32], inout credential_id[32..48]);
    attempt load_credential_key(ref rp_hash, ref credential_id[0..32]);
    var point: u8[65];
    n = attempt card.key.export_public(TEMP_KEY, inout point);

    // authData: rpIdHash, flags (UP | AT), signCount, then the attested credential data.
    var auth: u8[180];
    auth[0..32] = rp_hash;
    auth[32] = 0x41;
    if uv {
        auth[32] = 0x45;
    }
    auth[33..37] = encode_be(sign_count);
    auth[37..53] = AAGUID;
    auth[53] = 0;
    auth[54] = 48;
    auth[55..103] = credential_id;
    var cose_size: u32 = attempt write_cose_key(ref point, -7, inout auth[103..180]);

    // {1: "none", 2: authData, 3: {}}
    response[0] = 0;
    var at: u32 = 1;
    at += attempt card.cbor.write_head(CborMajor.Map, 3, inout response[at..response.length]);
    at += attempt card.cbor.write_int(1, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref FMT_NONE, inout response[at..response.length]);
    at += attempt card.cbor.write_int(2, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Bytes, ref auth, inout response[at..response.length]);
    at += attempt card.cbor.write_int(3, inout response[at..response.length]);
    at += attempt card.cbor.write_head(CborMajor.Map, 0, inout response[at..response.length]);
    return Ok(at);
}

// authenticatorGetAssertion (0x02), for one credential from the allowList.
function get_assertion(params: ref u8[], response: inout u8[]) -> u32 {
    var p: u32[8];
    var end: u32 = attempt index_map(ref params, 0, inout p);
    require (p[1] != 0) and (p[2] != 0) else IsoError.CtapMissingParameter;
    var rp_id: Span = attempt read_string(ref params, p[1], CborMajor.Text);
    var client_hash: Span = attempt read_string(ref params, p[2], CborMajor.Bytes);
    require client_hash.length == 32 else IsoError.CtapInvalidParameter;
    var options: Options = attempt read_options(ref params, p[5]);
    require not options.rk else IsoError.CtapUnsupportedOption;
    require not options.uv else IsoError.CtapUnsupportedOption;
    var uv: bool = attempt check_token_param(ref params, client_hash, p[6], p[7]);
    var rp_hash: u8[32];
    var n: u32 = attempt card.crypto.digest(DigestAlgorithm.Sha256, ref params[rp_id.start..rp_id.start + rp_id.length], inout rp_hash);
    require p[3] != 0 else IsoError.CtapNoCredentials;
    var id_start: u32 = attempt first_valid(ref params, p[3], ref rp_hash);
    require id_start != 0 else IsoError.CtapNoCredentials;

    transaction {
        sign_count += 1;
    }
    var flags: u8 = 0;
    if options.up {
        flags = 0x01;
    }
    if uv {
        flags |= 0x04;
    }
    // The signed data: authData (rpIdHash, flags, signCount), then clientDataHash.
    var signed: u8[69];
    signed[0..32] = rp_hash;
    signed[32] = flags;
    signed[33..37] = encode_be(sign_count);
    signed[37..69] = params[client_hash.start..client_hash.start + 32];
    attempt load_credential_key(ref rp_hash, ref params[id_start..id_start + 32]);
    var raw: u8[64];
    n = attempt card.crypto.sign(TEMP_KEY, SignatureAlgorithm.EcdsaP256Sha256, ref signed, inout raw);
    var der: u8[72];
    var der_size: u32 = attempt der_signature(ref raw, inout der);

    // {1: {"id": credentialId, "type": "public-key"}, 2: authData, 3: signature}
    response[0] = 0;
    var at: u32 = 1;
    at += attempt card.cbor.write_head(CborMajor.Map, 3, inout response[at..response.length]);
    at += attempt card.cbor.write_int(1, inout response[at..response.length]);
    at += attempt card.cbor.write_head(CborMajor.Map, 2, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref KEY_ID, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Bytes, ref params[id_start..id_start + 48], inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref KEY_TYPE, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Text, ref PUBLIC_KEY, inout response[at..response.length]);
    at += attempt card.cbor.write_int(2, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Bytes, ref signed[0..37], inout response[at..response.length]);
    at += attempt card.cbor.write_int(3, inout response[at..response.length]);
    at += attempt card.cbor.write_string(CborMajor.Bytes, ref der[0..der_size], inout response[at..response.length]);
    return Ok(at);
}

// authenticatorReset (0x07): new HMAC keys invalidate every credential issued so far.
function reset_authenticator(response: inout u8[]) -> u32 {
    transaction {
        attempt card.key.delete(MAC_KEY);
        attempt card.key.delete(DERIVE_KEY);
        attempt card.key.generate(MAC_KEY, KeySpec { type: KeyType.Hmac256, storage: KeyStorage.Persistent });
        attempt card.key.generate(DERIVE_KEY, KeySpec { type: KeyType.Hmac256, storage: KeyStorage.Persistent });
        sign_count = 0;
        pin_set = false;
        pin_retries = 8;
        wipe pin_hash;
    }
    pin_failures = 0;
    attempt new_token();
    response[0] = 0;
    return Ok(1);
}
