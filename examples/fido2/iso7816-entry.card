// The ISO 7816 binding entry point (profile §11.1) for CTAP over NFC (CTAP 2.1 §11.3).
// The only binding-specific file: a raw-binding build would replace it, and keep every other file.

// SELECT of the FIDO applet returns the version string (BP-50a).
function on_select(response: inout u8[]) -> u32 {
    var version: u8[8] = b"FIDO_2_0";
    response[0..8] = version;
    return Ok(8);
}

// Write a one-byte CTAP status response.
function status(response: inout u8[], code: u8) -> u32 {
    response[0] = code;
    return Ok(1);
}

// request: CLA INS P1 P2, then the data field (BP-50). INS 0x10 is NFCCTAP_MSG; 0x12 is NFCCTAP_CONTROL.
command process(request: ref u8[], response: inout u8[]) -> u32 {
    require request.length >= 4 else IsoError.WrongLength;
    var ins: u8 = request[1];
    if ins == 0x12 {
        return Ok(0);
    }
    require ins == 0x10 else IsoError.InsNotSupported;
    match ctap(ref request[4..request.length], inout response) {
        Ok(count) => {
            return Ok(count);
        }
        Err(IsoError(code)) => {
            // Every error ctap() returns is a Ctap* member, whose code is 0x91 followed by the CTAP status byte.
            var ctap_status: u8 = truncate<u8>(code);
            return status(inout response, ctap_status);
        }
        Err(error) => {
            return Err(error);
        }
    }
}
