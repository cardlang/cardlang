// Non-resident credentials with derived keys (WP8 F2). A credential ID is nonce (32 bytes) || tag (16 bytes):
//   tag = the first 16 bytes of HMAC(MAC_KEY, rpIdHash || nonce)
//   d   = HMAC(DERIVE_KEY, rpIdHash || nonce), the credential's P-256 private key
// Nothing is stored per credential. Both HMAC keys are persistent Hmac256 keys that never leave the platform.

function on_install() {
    attempt card.key.generate(MAC_KEY, KeySpec { type: KeyType.Hmac256, storage: KeyStorage.Persistent });
    attempt card.key.generate(DERIVE_KEY, KeySpec { type: KeyType.Hmac256, storage: KeyStorage.Persistent });
    return Ok();
}

// Write the 16-byte tag of a credential nonce for an RP.
function credential_tag(rp_hash: ref u8[], nonce: ref u8[], tag: inout u8[]) {
    var material: u8[64];
    material[0..32] = rp_hash;
    material[32..64] = nonce;
    var full: u8[32];
    var n: u32 = attempt card.crypto.mac(MAC_KEY, MacAlgorithm.HmacSha256, ref material, inout full);
    tag[0..16] = full[0..16];
    return Ok();
}

// Derive the credential's private key and load it as TEMP_KEY, a volatile key. The caller deletes TEMP_KEY.
function load_credential_key(rp_hash: ref u8[], nonce: ref u8[]) {
    // A command that trapped while TEMP_KEY existed leaves it behind: volatile keys survive traps (BP-14).
    ignore card.key.delete(TEMP_KEY);
    var material: u8[64];
    material[0..32] = rp_hash;
    material[32..64] = nonce;
    var derived: u8[32];
    var n: u32 = attempt card.crypto.mac(DERIVE_KEY, MacAlgorithm.HmacSha256, ref material, inout derived);
    match card.key.import(TEMP_KEY, KeySpec { type: KeyType.EcP256Private, storage: KeyStorage.Volatile }, ref derived) {
        Ok() => {
        }
        Err(_) => {
            wipe derived;
            return Err(IsoError.CtapOther);      // d = 0 or d >= n: probability about 2^-32
        }
    }
    wipe derived;
    return Ok();
}

// The offset of the ID bytes of the first credential in the descriptor array at `at` that belongs to this
// authenticator and RP, or 0 if there is none.
function first_valid(data: ref u8[], at: u32, rp_hash: ref u8[]) -> u32 {
    var list: CborHead = attempt card.cbor.head(ref data[at..data.length]);
    require list.major == CborMajor.Array else IsoError.CtapUnexpectedType;
    var cursor: u32 = at + list.size;
    var found: u32 = 0;
    for item: u32 in 0..list.argument {
        var id_at: u32 = attempt find_text_key(ref data, cursor, ref KEY_ID);
        var type_ok: bool = attempt has_public_key_type(ref data, cursor);
        if (found == 0) and (id_at != 0) and type_ok {
            var id: Span = attempt read_string(ref data, id_at, CborMajor.Bytes);
            if id.length == 48 {
                var tag: u8[16];
                attempt credential_tag(ref rp_hash, ref data[id.start..id.start + 32], inout tag);
                if equal(ref data[id.start + 32..id.start + 48], ref tag) {
                    found = id.start;
                }
            }
        }
        var item_size: u32 = attempt card.cbor.skip(ref data[cursor..data.length]);
        cursor += item_size;
    }
    return Ok(found);
}
