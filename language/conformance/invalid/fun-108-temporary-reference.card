// rule: FUN-9
// source: DN §3.8
// status: agreed
// kind: fragment
// expect: compile-error CE-FUN-3
// note: A reference to a temporary constructor value.
struct Account {
    balance: u32;
}

function get_balance(source: ref Account) -> u32 {
    return Ok(source.balance);
}

function check() {
    var balance: u32 = attempt get_balance(ref Account { balance: 0 });
    return Ok();
}
