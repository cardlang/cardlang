// rule: STA-9
// source: D-422
// status: agreed
// kind: fragment
// expect: compile-error CE-STA-3
// note: Application code calls a handler.
persistent installed_version: u16;

function on_install() {
    installed_version = 1;
    return Ok();
}

function reinstall() {
    attempt on_install();
    return Ok();
}
