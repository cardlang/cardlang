// rule: PLT-25, EXP-47
// source: platform/base-profile.md BP-26 to BP-33
// kind: fragment
// expect: compile-error CE-EXP-1
// note: A MAC algorithm passed where a digest algorithm is required.
function hash(data: ref u8[], out: inout u8[]) -> u32 {
    var length: u32 = attempt card.crypto.digest(MacAlgorithm.HmacSha256, ref data, inout out);
    return Ok(length);
}
