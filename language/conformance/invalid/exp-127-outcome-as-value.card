// rule: EXP-48
// source: DN §3.5
// kind: fragment
// expect: compile-error CE-EXP-14
// note: A call outcome used as an arithmetic operand.
session balance: u32;

function subtract(current_balance: u32, amount: u32) -> u32 {
    return Ok(current_balance - amount);
}

function check(amount: u32) {
    var result: u32 = balance + subtract(balance, amount);
    return Ok();
}
