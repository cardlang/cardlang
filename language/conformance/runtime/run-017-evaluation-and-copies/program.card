// rule: EXP-27, EXP-46, EXP-50, FUN-11, FUN-17, FUN-23, TXN-5, HEP-7
// source: D-336, D-116, D-104, D-353, D-358, D-133, D-356, D-383, D-372, D-385; DN §3.5, §3.7, §3.8, §4, §7.1, §7.2, §8.4, §9.2
// kind: application
// expect: runtime
// note: Evaluation order of attempt operands, independent copies, runtime bitwise results, argument preparation before entry, inout writes in an aborted transaction, no implicit command transaction, separate request and response.
errors TestError {
    UnknownOperation = 1;
    Refused = 2;
}

struct Pair {
    left: u8;
    right: u8;
}

struct Holder {
    data: u8[2];
}

session order: u32;
session reached: bool;
persistent total: u32;
persistent saved: u8[2];

function first() -> u32 {
    order = (order * 4) + 1;
    return Ok(1);
}

function second() -> u32 {
    order = (order * 4) + 2;
    return Ok(2);
}

function mark(value: ref u8) -> u8 {
    reached = true;
    return Ok(value);
}

function snapshot() -> u8[2] {
    return Ok(saved);
}

function bump(value: inout u32) {
    value = value + 1;
    return Ok();
}

function respond(output: inout u8[], value: u32) -> u32 {
    var bytes: u8[4] = encode_be(value);
    for index: u32 in 0..4 {
        output[index] = bytes[index];
    }
    return Ok(4);
}

command process(request: ref u8[], response: inout u8[]) -> u32 {
    var operation: u8 = request[0];
    if operation == 1 {
        order = 0;
        var sum: u32 = attempt first() + attempt second();
        return respond(inout response, order);
    } else if operation == 2 {
        var a: Pair = Pair { left: 1, right: 2 };
        var b: Pair = a;
        b.left = 9;
        var source: u8[2] = [3, 4];
        var holder: Holder = Holder { data: source };
        source[0] = 5;
        var copy: u8[2] = attempt snapshot();
        copy[0] = 9;
        response[0] = a.left;
        response[1] = b.left;
        response[2] = holder.data[0];
        response[3] = saved[0];
        response[4] = copy[0];
        return Ok(5);
    } else if operation == 3 {
        var x: u8 = request[1];
        var y: u8 = request[2];
        response[0] = x & y;
        response[1] = x | y;
        response[2] = x ^ y;
        response[3] = ~x;
        response[4] = x << 3;
        response[5] = x >> 2;
        return Ok(6);
    } else if operation == 4 {
        reached = false;
        var value: u8 = attempt mark(ref request[1]);
        return Ok(0);
    } else if operation == 5 {
        if reached {
            response[0] = 1;
        } else {
            response[0] = 0;
        }
        return Ok(1);
    } else if operation == 6 {
        transaction {
            match bump(inout total) {
                Ok() => {
                }
                Err(_) => {
                }
            }
            abort Err(TestError.Refused);
        }
    } else if operation == 7 {
        transaction {
            match bump(inout total) {
                Ok() => {
                }
                Err(_) => {
                }
            }
        }
        return Ok(0);
    } else if operation == 8 {
        return respond(inout response, total);
    } else if operation == 9 {
        total = total + 10;
        var missing: u8 = request[200];
        return Ok(0);
    } else if operation == 10 {
        response[0] = 255;
        response[1] = request[0];
        return Ok(2);
    }
    return Err(TestError.UnknownOperation);
}
