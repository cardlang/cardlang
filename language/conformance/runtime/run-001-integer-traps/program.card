// rule: RTF-4, EXP-23, EXP-24, EXP-25, EXP-26, EXP-30
// source: DN §3.5, §6.5
// kind: application
// expect: runtime
// note: Integer traps and wrapping results, with operand values taken from the request.
errors TestError {
    UnknownOperation = 1;
}

command process(request: ref u8[], response: inout u8[]) -> u32 {
    var operation: u8 = request[0];
    var a: u8 = request[1];
    var s: i8 = truncate<i8>(request[1]);
    if operation == 1 {
        var r: u8 = a + 1;
        response[0] = r;
        return Ok(1);
    } else if operation == 2 {
        var r: u8 = a - 1;
        response[0] = r;
        return Ok(1);
    } else if operation == 3 {
        var q: u8 = 100 / a;
        response[0] = q;
        return Ok(1);
    } else if operation == 4 {
        var q: i8 = s / -1;
        response[0] = truncate<u8>(q);
        return Ok(1);
    } else if operation == 5 {
        var r: i8 = s % -1;
        response[0] = truncate<u8>(r);
        return Ok(1);
    } else if operation == 6 {
        var shifted: u8 = 1 << a;
        response[0] = shifted;
        return Ok(1);
    } else if operation == 7 {
        var negated: i8 = -s;
        response[0] = truncate<u8>(negated);
        return Ok(1);
    } else if operation == 8 {
        var wrapped: u8 = wrapping_add(a, 10);
        response[0] = wrapped;
        return Ok(1);
    } else if operation == 9 {
        var q: i8 = s / 2;
        var r: i8 = s % 2;
        response[0] = truncate<u8>(q);
        response[1] = truncate<u8>(r);
        return Ok(2);
    }
    return Err(TestError.UnknownOperation);
}
