// rule: OUT-21, OUT-22, STM-24, STM-25, EXP-55, TXN-18
// source: D-453, D-454, D-455, D-456, D-457
// kind: application
// expect: runtime
// note: Error codes through Err(Set(code)), attempt-else in and out of a transaction, ignore, compound assignment and its single evaluation.
errors AppError {
    Alpha = 0x9101;
    Beta = 0x9102;
    Gamma = 0x9103;
}

persistent total: u32;
session calls: u8;
session values: u8[4];

function fail_beta() -> u32 {
    return Err(AppError.Beta);
}

function next() -> u32 {
    calls += 1;
    return Ok(2);
}

command process(request: ref u8[], response: inout u8[]) -> u32 {
    var operation: u8 = request[0];
    if operation == 1 {
        match fail_beta() {
            Ok(value) => {
                return Ok(0);
            }
            Err(AppError(code)) => {
                response[0..2] = encode_be(code);
                return Ok(2);
            }
            Err(error) => {
                return Err(error);
            }
        }
    } else if operation == 2 {
        var length: u32 = attempt card.key.export_public(99, inout response) else AppError.Gamma;
        return Ok(length);
    } else if operation == 3 {
        transaction {
            total += 5;
            attempt card.key.delete(99) else AppError.Gamma;
        }
        return Ok(0);
    } else if operation == 4 {
        ignore card.key.delete(99);
        ignore fail_beta();
        response[0..2] = b"ok";
        return Ok(2);
    } else if operation == 5 {
        response[0..4] = encode_be(total);
        return Ok(4);
    } else if operation == 6 {
        var small: u8 = request[1];
        small += request[2];
        response[0] = small;
        return Ok(1);
    } else if operation == 7 {
        values[attempt next()] += 1;
        response[0] = calls;
        response[1] = values[2];
        return Ok(2);
    } else if operation == 8 {
        transaction {
            total += 5;
        }
        return Ok(0);
    }
    return Err(AppError.Alpha);
}
