// rule: STM-16, STM-20
// source: DN §3.7, §3.11
// kind: fragment
// expect: ok
// note: A match whose arms complete normally, followed by a return.
enum Mode {
    Off;
    On;
}

session mode: Mode;
session level: u8;

function apply() {
    match mode {
        Mode.Off => {
            level = 0;
        }
        Mode.On => {
            level = 1;
        }
    }
    return Ok();
}
