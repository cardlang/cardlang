// rule: TXN-18
// source: D-445; DN §6.3
// kind: fragment
// expect: ok
// note: attempt inside a transaction: its error path aborts the transaction.
persistent balance: u32;

function read_amount() -> u32 {
    return Ok(5);
}

function check() {
    transaction {
        var amount: u32 = attempt read_amount();
        balance = amount;
    }
    return Ok();
}
