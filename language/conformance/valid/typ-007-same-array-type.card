// rule: TYP-4
// source: DN §8.2
// status: agreed
// kind: fragment
// expect: ok
// note: Two array types written differently are identical, so whole-array assignment between them is accepted.
const BLOCK: u32 = 32;
session first: u8[BLOCK * 4];
session second: u8[128];

function copy_buffer() {
    second = first;
    return Ok();
}
