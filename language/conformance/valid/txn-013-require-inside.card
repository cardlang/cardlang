// rule: TXN-18
// source: D-445; DN §3.6
// kind: fragment
// expect: ok
// note: require inside a transaction: a false condition aborts the transaction.
persistent balance: u32;

errors WalletError {
    InsufficientFunds = 1;
    Unauthorized = 2;
}

function check(ready: bool) {
    transaction {
        require ready else WalletError.Unauthorized;
        balance = 0;
    }
    return Ok();
}
