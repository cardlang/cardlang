// rule: EXP-33
// source: DN §3.2
// kind: fragment
// expect: ok
// note: A checked conversion consumed by match.
function narrow(incoming: u16) -> u8 {
    match checked_convert<u8>(incoming) {
        Ok(value) => {
            return Ok(value);
        }
        Err(error) => {
            return Err(error);
        }
    }
}
