// rule: FUN-24
// source: D-447
// status: agreed
// kind: fragment
// expect: ok
// note: Slice assignments from a list, fill, another slice, a whole array and a view.
session buffer: u8[8];
session block: u8[4];

function check(source: ref u8[], output: inout u8[]) {
    buffer[0..4] = [1, 2, 3, 4];
    buffer[4..8] = fill(0);
    buffer[2..6] = buffer[0..4];
    buffer[4..8] = block;
    output[0..2] = source[0..2];
    return Ok();
}
