// rule: CEX-1, CEX-3
// source: DN §3.10
// kind: fragment
// expect: ok
// note: Global constants built from literals, other constants, operators (comparisons with `<` among them) and `fill`.
const BASE: u32 = 32;
const CAPACITY: u32 = BASE * 4;
const MASK: u8 = 0x0F;
const DEFAULT_ID: u8[4] = fill(0);
const IN_RANGE: bool = (BASE < CAPACITY) and (0 < BASE);
