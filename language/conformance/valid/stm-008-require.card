// rule: STM-19
// source: DN §6.1
// kind: fragment
// expect: ok
// note: require before a subtraction it makes safe.
errors WalletError {
    InsufficientFunds = 1;
}

function subtract(current_balance: u32, amount: u32) -> u32 {
    require amount <= current_balance else WalletError.InsufficientFunds;
    return Ok(current_balance - amount);
}
