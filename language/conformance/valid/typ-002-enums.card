// rule: TYP-10, TYP-11
// source: DN §3.11
// status: agreed
// kind: fragment
// expect: ok
// note: An enum used as a global, an array element type and a field type.
enum OperationState {
    Idle;
    Receiving;
    Complete;
}

struct Operation {
    state: OperationState;
    received: u32;
}

session state: OperationState;
session history: OperationState[4];
session operation: Operation;
