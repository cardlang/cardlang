// rule: EXP-55
// source: D-453
// status: agreed
// kind: fragment
// expect: ok
// note: Byte strings as constants and initializers, and compared with equal.
const KEY_ID: u8[2] = b"id";

function check() -> bool {
    var version: u8[8] = b"FIDO_2_0";
    var other: u8[2] = b"id";
    return Ok(equal(ref KEY_ID, ref other));
}
