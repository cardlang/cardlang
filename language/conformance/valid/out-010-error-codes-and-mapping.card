// rule: OUT-21, OUT-22
// source: D-454, D-455
// kind: fragment
// expect: ok
// note: An Err(Set(code)) arm, and attempt-else in both forms.
errors AppError {
    Alpha = 1;
    Beta = 2;
}

function get() -> u32 {
    return Err(AppError.Beta);
}

function act() {
    return Err(AppError.Alpha);
}

function check() -> u32 {
    match get() {
        Ok(value) => {
            return Ok(value);
        }
        Err(AppError(code)) => {
            var low: u8 = truncate<u8>(code);
        }
        Err(error) => {
            return Err(error);
        }
    }
    var value: u32 = attempt get() else AppError.Alpha;
    attempt act() else AppError.Beta;
    return Ok(value);
}
