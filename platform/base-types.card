// CardLang Base Profile 1: platform-supplied declarations (platform/base-profile.md §3).
// This file is implicitly part of every build for the profile. Its names are predeclared (NAM-14 item 4):
// an application that declares one of them is rejected (CE-NAM-5).
// The crypto, CBOR and DER/TLV families add their own declarations below.

// Keys (§7). Each value names one valid key type; later versions add values for new curves and sizes.
enum KeyType {
    Aes128;
    Aes256;
    EcP256Private;
    EcP256Public;
    Hmac256;
}

enum KeyStorage {
    Persistent;
    Volatile;
    Command;
}

struct KeySpec {
    type: KeyType;
    storage: KeyStorage;
}

// Cryptographic operations (§8). One enum per family, so a wrong algorithm is a compile-time error.
enum DigestAlgorithm {
    Sha256;
}

enum MacAlgorithm {
    HmacSha256;
}

enum SignatureAlgorithm {
    EcdsaP256Sha256;
}

enum KdfAlgorithm {
    HkdfSha256;
}

enum CipherAlgorithm {
    AesCbcNoPadding;
}

// Multi-part operations (§8, B5).
enum OperationLifetime {
    Command;
    Session;
}

// CBOR (§9). The major types of RFC 8949, and a decoded head.
enum CborMajor {
    Unsigned;
    Negative;
    Bytes;
    Text;
    Array;
    Map;
    Tag;
    Simple;
}

struct CborHead {
    major: CborMajor;
    argument: u32;
    size: u32;
}

// BER-TLV (§10). The tag is its raw bytes packed into a u32, big-endian, as card specifications write it.
enum TlvClass {
    Universal;
    Application;
    ContextSpecific;
    Private;
}

struct TlvHead {
    tag: u32;
    class: TlvClass;
    constructed: bool;
    length: u32;
    size: u32;
}
